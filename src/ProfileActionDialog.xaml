<Window x:Class="XEnchantmentPatcher.ProfileActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <StackPanel x:Name="NameFields">
            <TextBlock Text="Profile name" Margin="0,0,0,5"/>
            <TextBox x:Name="NameInput" MinHeight="28" AutomationProperties.Name="Profile name" ToolTip="Name this saved set of patching choices. Profile names must be unique."/>
        </StackPanel>
        <TextBlock x:Name="NameError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" MinWidth="90" Padding="12,6" Margin="0,0,8,0" IsDefault="True" Click="Accept" ToolTip="{Binding Text, ElementName=Explanation}"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" Padding="12,6" IsCancel="True" ToolTip="Close without applying this profile action."/>
        </StackPanel>
    </StackPanel>
</Window>
