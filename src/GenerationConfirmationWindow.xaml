<Window x:Class="XEnchantmentPatcher.GenerationConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XEnchantmentPatcher — Confirm generation" Width="760" Height="440"
        MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Ready to generate" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="IdentityNotice"
                           TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock Text="Choose your output" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock Text="Light plugins use no regular load-order slots. A single non-light plugin uses one regular slot." TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="FullOutputNotice" Text="This patch is too large for one non-light plugin. Choose light output."
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="ReportNotice" Text="The generation report will include detailed warnings and technical information."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"/>
            </StackPanel>
            </ScrollViewer>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel" MinWidth="110" Padding="12,7" Margin="0,0,10,6" ToolTip="Return without writing patch files. Your patching choices remain saved."/>
            <Button x:Name="GenerateLightButton" Click="GenerateLight" MinWidth="145" Padding="12,7" Margin="0,0,10,6" ToolTip="Write light (ESL-flagged) plugins of up to 4,096 new records each. They use no regular load-order slot."/>
            <Button x:Name="GenerateFullButton" Content="Generate 1 non-light plugin" Click="GenerateFull" MinWidth="145" Padding="12,7" Margin="0,0,0,6" ToolTip="Write a single regular XEnchantmentPatcher.esp. It uses one regular load-order slot."/>
        </WrapPanel>
    </Grid>
</Window>
