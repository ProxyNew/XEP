<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allow side-by-side build intermediates without compiling old bin/obj trees. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <CetCompat>false</CetCompat>
    <AssemblyName>XEnchantmentPatcher</AssemblyName>
    <RootNamespace>XEnchantmentPatcher</RootNamespace>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationIcon>Assets\iron-helmet-fire.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the separately licensed CLI replaceable and available without a runtime download. -->
    <None Update="ThirdParty\Champollion\*" Link="Champollion\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="Assets\iron-helmet-fire-busy.gif" />
    <None Include="..\docs\**\*" Link="docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\LICENSE;..\LICENSING.md;..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Runtime\XEP_QuestInsertion.pex" />
    <EmbeddedResource Include="Runtime\XEP_QuestInsertion.psc" />
    <EmbeddedResource Include="Runtime\XEP_ScriptGate.psc" />
    <EmbeddedResource Include="Runtime\XEP_ScriptGate.pex" />
    <EmbeddedResource Include="Runtime\XEP_ScriptGatePlayerAlias.psc" />
    <EmbeddedResource Include="Runtime\XEP_ScriptGatePlayerAlias.pex" />
  </ItemGroup>
</Project>
