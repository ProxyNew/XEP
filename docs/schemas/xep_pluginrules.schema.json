{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xep_pluginrules.schema.json",
  "title": "XEnchantmentPatcher mod-author rules file",
  "description": "Editor support for Data/XEnchantmentPatcher/xep_pluginrules.json (v1). Unknown properties are allowed so newer files stay readable; XEnchantmentPatcher reports them as warnings. See docs/MOD-AUTHOR-RULES-FILE.md.",
  "type": "object",
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/pluginEntry" } }
  },
  "$defs": {
    "formKey": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}:.+\\.[Ee][Ss][PpMmLl]$",
      "description": "Local form ID and defining plugin, for example 000800:ExampleGear.esp."
    },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/formKey" } },
    "distributionMode": {
      "enum": ["Disabled", "SpecializedLists", "GeneralLists", "BestAvailable", "SpecializedEnchantedLists", "MerchantFallback", "ScriptDistribution"]
    },
    "ruleCommon": {
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pluginEntry": {
      "type": "object",
      "required": ["plugin"],
      "properties": {
        "plugin": { "type": "string", "pattern": "^.+\\.[Ee][Ss][PpMmLl]$" },
        "defaults": {
          "type": "object",
          "properties": {
            "patchPolicy": { "enum": ["ExistingDistribution", "Exclude"] },
            "distributionMode": { "$ref": "#/$defs/distributionMode" },
            "reason": { "type": "string" }
          }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/itemRule" } },
        "enchantments": { "type": "array", "items": { "$ref": "#/$defs/enchantmentRule" } }
      }
    },
    "itemRule": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/ruleCommon" }],
      "required": ["records"],
      "anyOf": [{ "required": ["include"] }, { "required": ["materialFamily"] }, { "required": ["distributionMode"] }, { "required": ["allowedEnchantments"] }, { "required": ["allowedDestinations"] }],
      "properties": {
        "records": { "$ref": "#/$defs/records" },
        "include": { "type": "boolean" },
        "materialFamily": { "type": "string", "minLength": 1 },
        "distributionMode": { "$ref": "#/$defs/distributionMode" },
        "allowedEnchantments": { "$ref": "#/$defs/records", "description": "Enchantment FormKeys (or family base enchantments) this item may use. List \"allowedEnchantments\" in requires." },
        "allowedDestinations": { "$ref": "#/$defs/records", "description": "Leveled item lists (covering every list below) or containers this item's variants may be placed in. List \"allowedDestinations\" in requires." }
      },
      "allOf": [
        { "if": { "required": ["allowedEnchantments"] },
          "then": { "required": ["requires"], "properties": { "requires": { "contains": { "const": "allowedEnchantments" } } } } },
        { "if": { "required": ["allowedDestinations"] },
          "then": { "required": ["requires"], "properties": { "requires": { "contains": { "const": "allowedDestinations" } } } } }
      ]
    },
    "enchantmentRule": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/ruleCommon" }],
      "required": ["records", "enabled"],
      "properties": {
        "records": { "$ref": "#/$defs/records" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
